@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");

:root {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;
  color: #18181b;
  background: #f4f4f5;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  min-height: 100%;
  margin: 0;
}

body {
  min-height: 100vh;
  background: #f4f4f5;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

.hide-scrollbar::-webkit-scrollbar {
  display: none;
}

.hide-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* ============================================================
   Glassmorphism navigation
   ============================================================ */

.glass-bottom-nav {
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: max(10px, env(safe-area-inset-bottom));
  height: 68px;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 7px 9px;
  z-index: 40;

  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.82);
  border-radius: 24px;

  -webkit-backdrop-filter: blur(22px) saturate(150%);
  backdrop-filter: blur(22px) saturate(150%);

  box-shadow:
    0 10px 35px rgba(15, 23, 42, 0.10),
    0 2px 10px rgba(15, 23, 42, 0.05);
}

.glass-nav-item {
  width: 62px;
  height: 54px;
  border: 0;
  background: transparent;
  color: #a1a1aa;
  border-radius: 18px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;

  cursor: pointer;

  transition:
    color 180ms ease,
    background 180ms ease,
    transform 180ms ease,
    box-shadow 180ms ease;
}

.glass-nav-item span {
  font-size: 9px;
  line-height: 1;
  font-weight: 700;
}

.glass-nav-item:hover {
  color: #52525b;
}

.glass-nav-item.active {
  color: #2563eb;
  background: rgba(239, 246, 255, 0.88);

  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.9),
    0 4px 12px rgba(37, 99, 235, 0.08);

  transform: translateY(-1px);
}

.glass-nav-spacer {
  width: 62px;
  flex-shrink: 0;
}

/* ============================================================
   Floating transaction button
   ============================================================ */

.finance-fab {
  position: absolute;
  left: 50%;
  bottom: 34px;
  transform: translateX(-50%);
  z-index: 45;

  width: 62px;
  height: 62px;
  border: 4px solid rgba(255, 255, 255, 0.94);
  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  color: white;
  background: linear-gradient(145deg, #3b82f6, #2563eb);

  box-shadow:
    0 12px 30px rgba(37, 99, 235, 0.34),
    0 3px 10px rgba(15, 23, 42, 0.10);

  cursor: pointer;

  transition:
    transform 180ms ease,
    box-shadow 180ms ease;
}

.finance-fab:hover {
  box-shadow:
    0 15px 34px rgba(37, 99, 235, 0.40),
    0 3px 10px rgba(15, 23, 42, 0.10);
}

.finance-fab:active {
  transform: translateX(-50%) scale(0.94);
}

/* ============================================================
   Financial Plans switch
   ============================================================ */

.plans-segmented {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px;
  padding: 4px;

  background: rgba(244, 244, 245, 0.78);
  border: 1px solid rgba(228, 228, 231, 0.85);
  border-radius: 17px;

  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
}

.plans-segmented button {
  min-height: 44px;
  border: 0;
  border-radius: 13px;
  background: transparent;
  color: #71717a;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  font-size: 11px;
  font-weight: 800;
  cursor: pointer;

  transition:
    background 180ms ease,
    color 180ms ease,
    box-shadow 180ms ease;
}

.plans-segmented button.active {
  background: rgba(255, 255, 255, 0.96);
  color: #2563eb;

  box-shadow:
    0 3px 10px rgba(15, 23, 42, 0.07),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

/* ============================================================
   Shared forms
   ============================================================ */

.finance-label {
  display: block;
  margin-bottom: 6px;
  color: #71717a;
  font-size: 10px;
  line-height: 1.2;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.finance-input {
  width: 100%;
  padding: 12px 14px;

  border: 1px solid #e4e4e7;
  border-radius: 13px;

  background: #fafafa;
  color: #18181b;
  outline: none;

  transition:
    border-color 160ms ease,
    background 160ms ease,
    box-shadow 160ms ease;
}

.finance-input:focus {
  background: white;
  border-color: #60a5fa;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.10);
}

.modal-sheet {
  width: 100%;
  max-width: 448px;
  max-height: 88vh;
  overflow-y: auto;

  background: white;
  padding: 24px;
  border-radius: 32px 32px 0 0;

  border: 1px solid #f4f4f5;
  box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.14);

  animation: slideUp .35s cubic-bezier(.16,1,.3,1) forwards;

  padding-bottom: max(24px, env(safe-area-inset-bottom));
}

.modal-close {
  width: 34px;
  height: 34px;
  border: 0;
  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #71717a;
  background: #f4f4f5;
  cursor: pointer;
}

.modal-close:hover {
  background: #e4e4e7;
}

/* ============================================================
   Mobile adjustments
   ============================================================ */

@media (max-width: 480px) {
  .glass-bottom-nav {
    left: 10px;
    right: 10px;
    height: 66px;
  }

  .glass-nav-item,
  .glass-nav-spacer {
    width: 58px;
  }

  .finance-fab {
    bottom: 33px;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}
