// ============================================================
// Add transaction modal
// ============================================================

const AddTransactionModal = ({
  isOpen,
  onClose,
  onAdd,
  accounts,
}: {
  isOpen: boolean;
  onClose: () => void;
  onAdd: (tx: {
    amount: number;
    type: string;
    desc: string;
    account: string;
    date: string;
    category: string;
  }) => void | Promise<void>;
  accounts: AccountData[];
}) => {
  const [type, setType] = useState("expense");
  const [amount, setAmount] = useState("");
  const [desc, setDesc] = useState("");
  const [account, setAccount] = useState("");

  if (!isOpen) return null;

  const handleSubmit = (event: React.FormEvent) => {
    event.preventDefault();

    const parsed = parseInputValue(amount);
    if (!amount || !Number.isFinite(parsed) || parsed <= 0) return;

    const selected = account || accounts[0]?.name || "";

    onAdd({
      amount: parsed,
      type,
      desc,
      account: selected,
      date: new Date().toISOString().split("T")[0],
      category: type === "expense" ? "General" : "Income",
    });

    setAmount("");
    setDesc("");
    setAccount("");
    onClose();
  };

  return (
    <div className="fixed inset-0 bg-zinc-900/60 backdrop-blur-sm z-[70] flex items-end justify-center">
      <div className="modal-sheet">
        <div className="flex justify-between items-center mb-6">
          <div>
            <p className="text-xs font-bold uppercase tracking-widest text-blue-600">
              Transaction
            </p>
            <h2 className="text-xl font-bold text-zinc-900">New Transaction</h2>
          </div>
          <button onClick={onClose} className="modal-close">
            <X size={18} />
          </button>
        </div>

        <form onSubmit={handleSubmit} className="space-y-4 pb-8">
          <div className="grid grid-cols-2 gap-2 bg-zinc-100 p-1 rounded-xl">
            <button
              type="button"
              onClick={() => setType("expense")}
              className={`py-2.5 rounded-lg text-xs font-bold ${
                type === "expense"
                  ? "bg-white text-red-500 shadow-sm"
                  : "text-zinc-500"
              }`}
            >
              Expense
            </button>
            <button
              type="button"
              onClick={() => setType("income")}
              className={`py-2.5 rounded-lg text-xs font-bold ${
                type === "income"
                  ? "bg-white text-emerald-600 shadow-sm"
                  : "text-zinc-500"
              }`}
            >
              Income
            </button>
          </div>

          <div>
            <label className="finance-label">Amount (MMK)</label>
            <input
              type="text"
              inputMode="numeric"
              value={amount}
              onChange={(e) => setAmount(formatInputValue(e.target.value))}
              className="finance-input text-2xl font-bold"
              placeholder="0"
              required
            />
          </div>

          <div>
            <label className="finance-label">Description</label>
            <input
              value={desc}
              onChange={(e) => setDesc(e.target.value)}
              className="finance-input"
              placeholder="e.g. Lunch, Salary"
              required
            />
          </div>

          <div>
            <label className="finance-label">Account</label>
            <select
              value={account || accounts[0]?.name || ""}
              onChange={(e) => setAccount(e.target.value)}
              className="finance-input"
            >
              {accounts.map((acc) => (
                <option key={acc.id} value={acc.name}>
                  {acc.name} ({formatMMK(acc.balance)} MMK)
                </option>
              ))}
            </select>
          </div>

          <button
            type="submit"
            className={`w-full py-4 rounded-xl text-white font-bold ${
              type === "expense"
                ? "bg-red-500 hover:bg-red-600"
                : "bg-emerald-500 hover:bg-emerald-600"
            }`}
          >
            Log {type === "expense" ? "Expense" : "Income"}
          </button>
        </form>
      </div>
    </div>
  );
};

// ============================================================
// Transfer modal
// ============================================================

const TransferModal = ({
  isOpen,
  onClose,
  onTransfer,
  accounts,
}: {
  isOpen: boolean;
  onClose: () => void;
  onTransfer: (data: {
    fromAccountId: number;
    toAccountId: number;
    amount: number;
    desc: string;
  }) => Promise<void>;
  accounts: AccountData[];
}) => {
  const [fromId, setFromId] = useState("");
  const [toId, setToId] = useState("");
  const [amount, setAmount] = useState("");
  const [desc, setDesc] = useState("");
  const [error, setError] = useState("");
  const [submitting, setSubmitting] = useState(false);

  if (!isOpen) return null;

  const from = fromId || accounts[0]?.id.toString() || "";
  const to =
    toId ||
    (accounts.length > 1
      ? accounts[1].id.toString()
      : accounts[0]?.id.toString() || "");

  const close = () => {
    setFromId("");
    setToId("");
    setAmount("");
    setDesc("");
    setError("");
    onClose();
  };

  const submit = async (event: React.FormEvent) => {
    event.preventDefault();
    const parsed = parseInputValue(amount);

    if (!from || !to || from === to) {
      setError("Choose two different accounts.");
      return;
    }

    if (!Number.isFinite(parsed) || parsed <= 0) {
      setError("Enter a valid amount.");
      return;
    }

    setSubmitting(true);
    setError("");

    try {
      await onTransfer({
        fromAccountId: Number(from),
        toAccountId: Number(to),
        amount: parsed,
        desc,
      });
      close();
    } catch (error) {
      setError(getErrorMessage(error));
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="fixed inset-0 bg-zinc-900/60 backdrop-blur-sm z-[70] flex items-end justify-center">
      <div className="modal-sheet">
        <div className="flex justify-between items-center mb-6">
          <div className="flex items-center gap-2">
            <div className="bg-indigo-100 text-indigo-600 p-1.5 rounded-lg">
              <ArrowRightLeft size={18} />
            </div>
            <h2 className="text-xl font-bold">Transfer Funds</h2>
          </div>
          <button onClick={close} className="modal-close">
            <X size={18} />
          </button>
        </div>

        {error && (
          <div className="mb-4 bg-red-50 border border-red-200 text-red-600 p-3 rounded-xl text-sm">
            {error}
          </div>
        )}

        <form onSubmit={submit} className="space-y-4 pb-8">
          <div>
            <label className="finance-label">From Account</label>
            <select
              value={from}
              onChange={(e) => setFromId(e.target.value)}
              className="finance-input"
              disabled={submitting}
            >
              {accounts.map((acc) => (
                <option key={acc.id} value={acc.id}>
                  {acc.name} ({formatMMK(acc.balance)} MMK)
                </option>
              ))}
            </select>
          </div>

          <div className="flex justify-center">
            <ArrowRightLeft size={18} className="text-zinc-400 rotate-90" />
          </div>

          <div>
            <label className="finance-label">To Account</label>
            <select
              value={to}
              onChange={(e) => setToId(e.target.value)}
              className="finance-input"
              disabled={submitting}
            >
              {accounts.map((acc) => (
                <option key={acc.id} value={acc.id}>
                  {acc.name}
                </option>
              ))}
            </select>
          </div>

          <div>
            <label className="finance-label">Amount (MMK)</label>
            <input
              type="text"
              inputMode="numeric"
              value={amount}
              onChange={(e) => setAmount(formatInputValue(e.target.value))}
              className="finance-input text-2xl font-bold"
              placeholder="0"
              required
              disabled={submitting}
            />
          </div>

          <div>
            <label className="finance-label">Notes (Optional)</label>
            <input
              value={desc}
              onChange={(e) => setDesc(e.target.value)}
              className="finance-input"
              placeholder="e.g. Move money to savings"
              disabled={submitting}
            />
          </div>

          <button
            type="submit"
            disabled={submitting || accounts.length < 2}
            className="w-full py-4 rounded-xl text-white font-bold bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50"
          >
            {submitting ? "Processing..." : "Confirm Transfer"}
          </button>
        </form>
      </div>
    </div>
  );
};

// ============================================================
// PIN screen
// ============================================================

const PinScreen = ({ onUnlocked }: { onUnlocked: () => Promise<void> }) => {
  const [pin, setPin] = useState("");
  const [rememberHours, setRememberHours] = useState<24 | 48>(48);
  const [error, setError] = useState("");
  const [submitting, setSubmitting] = useState(false);

  const submit = async (event: React.FormEvent) => {
    event.preventDefault();
    setError("");
    setSubmitting(true);

    try {
      const response = await api.post<PinResponse>("auth/pin.php", {
        pin,
        remember_hours: rememberHours,
      });

      setAuthToken(response.data.token, response.data.expires_at);
      await onUnlocked();
    } catch (error) {
      setError(getErrorMessage(error));
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="bg-zinc-100 h-screen overflow-hidden flex justify-center">
      <div className="w-full max-w-md bg-zinc-50 h-full flex flex-col justify-center px-6 border-x border-zinc-200">
        <div className="mb-8">
          <p className="text-xs font-bold uppercase tracking-[0.2em] text-blue-600 mb-3">
            Personal Finance
          </p>
          <h1 className="text-3xl font-extrabold tracking-tight">Enter PIN</h1>
          <p className="text-sm text-zinc-500 mt-2">
            Unlock your finance dashboard on this device.
          </p>
        </div>

        <form onSubmit={submit} className="space-y-5">
          <div>
            <label className="finance-label">4-digit PIN</label>
            <input
              type="password"
              inputMode="numeric"
              autoComplete="one-time-code"
              pattern="\d{4}"
              maxLength={4}
              value={pin}
              onChange={(e) =>
                setPin(e.target.value.replace(/\D/g, "").slice(0, 4))
              }
              className="w-full bg-white border border-zinc-200 rounded-xl py-4 px-4 text-3xl font-extrabold text-center tracking-[0.45em] outline-none focus:ring-2 focus:ring-blue-500"
              required
            />
          </div>

          <div>
            <label className="finance-label">Remember on this device</label>
            <div className="grid grid-cols-2 gap-2 bg-zinc-100 p-1 rounded-xl">
              {[24, 48].map((hours) => (
                <button
                  key={hours}
                  type="button"
                  onClick={() => setRememberHours(hours as 24 | 48)}
                  className={`py-2.5 rounded-lg font-bold text-xs ${
                    rememberHours === hours
                      ? "bg-white text-blue-600 shadow-sm"
                      : "text-zinc-500"
                  }`}
                >
                  {hours} hours
                </button>
              ))}
            </div>
          </div>

          {error && (
            <div className="bg-red-50 border border-red-200 text-red-700 rounded-xl p-3 text-xs font-semibold">
              {error}
            </div>
          )}

          <button
            type="submit"
            disabled={submitting}
            className="w-full py-4 bg-blue-600 hover:bg-blue-700 disabled:bg-blue-300 text-white font-bold rounded-xl"
          >
            {submitting ? "Unlocking..." : "Unlock"}
          </button>
        </form>
      </div>
    </div>
  );
};

// ============================================================
// Main application
// ============================================================

export default function App() {
  const [activeTab, setActiveTab] = useState("home");

  const [accounts, setAccounts] = useState<AccountData[]>([]);
  const [transactions, setTransactions] = useState<TransactionData[]>([]);
  const [loans, setLoans] = useState<LoanData[]>([]);
  const [categories, setCategories] = useState<CategoryData[]>([]);
  const [savings, setSavings] = useState<SavingsData[]>([]);

  const [isAddModalOpen, setIsAddModalOpen] = useState(false);
  const [isTransferModalOpen, setIsTransferModalOpen] = useState(false);
  const [isNewAccountModalOpen, setIsNewAccountModalOpen] = useState(false);
  const [isNewLoanModalOpen, setIsNewLoanModalOpen] = useState(false);
  const [isSavingsModalOpen, setIsSavingsModalOpen] = useState(false);

  const [isUnlocked, setIsUnlocked] = useState(false);
  const [syncStatus, setSyncStatus] = useState("Connecting...");
  const [isError, setIsError] = useState(false);
  const [isInitializing, setIsInitializing] = useState(true);

  const [newAccName, setNewAccName] = useState("");
  const [newAccType, setNewAccType] = useState("bank");
  const [newAccBalance, setNewAccBalance] = useState("");

  const [newLoanName, setNewLoanName] = useState("");
  const [newLoanType, setNewLoanType] = useState("borrowed");
  const [newLoanTotal, setNewLoanTotal] = useState("");
  const [newLoanRemaining, setNewLoanRemaining] = useState("");
  const [editingLoanId, setEditingLoanId] = useState<number | null>(null);

  const [financialPlanTab, setFinancialPlanTab] = useState<"loans" | "savings">(
    "loans",
  );

  const [editingSavingsId, setEditingSavingsId] = useState<number | null>(null);
  const [newSavingName, setNewSavingName] = useState("");
  const [newSavingTarget, setNewSavingTarget] = useState("");
  const [newSavingSaved, setNewSavingSaved] = useState("");
  const [newSavingDate, setNewSavingDate] = useState("");

  const resetFinanceState = useCallback(() => {
    setAccounts([]);
    setTransactions([]);
    setLoans([]);
    setCategories([]);
    setSavings([]);
  }, []);

  const loadFinanceData = useCallback(async () => {
    setSyncStatus("Syncing...");
    const timestamp = Date.now();

    const [
      accountsResponse,
      transactionsResponse,
      loansResponse,
      categoriesResponse,
      savingsResponse,
    ] = await Promise.all([
      api.get<AccountsResponse>(`accounts/index.php?_t=${timestamp}`),
      api.get<TransactionsResponse>(`transactions/index.php?_t=${timestamp}`),
      api.get<LoansResponse>(`loans/index.php?_t=${timestamp}`),
      api.get<CategoriesResponse>(`categories/index.php?_t=${timestamp}`),
      api.get<SavingsResponse>(`savings/index.php?_t=${timestamp}`),
    ]);

    setAccounts(accountsResponse.data.accounts);
    setTransactions(transactionsResponse.data.transactions);
    setLoans(loansResponse.data.loans);
    setCategories(categoriesResponse.data.categories);
    setSavings(savingsResponse.data.savings);
    setSyncStatus("API Synced");
    setIsError(false);
  }, []);

  useEffect(() => {
    const handleVisibility = () => {
      if (document.visibilityState === "visible" && isUnlocked) {
        loadFinanceData().catch((error) => {
          console.error("Background refresh failed:", error);
          setSyncStatus("API Error");
          setIsError(true);
        });
      }
    };

    document.addEventListener("visibilitychange", handleVisibility);
    return () =>
      document.removeEventListener("visibilitychange", handleVisibility);
  }, [isUnlocked, loadFinanceData]);

  useEffect(() => {
    let cancelled = false;

    const boot = async () => {
      if (!getAuthToken()) {
        setSyncStatus("PIN required");
        setIsInitializing(false);
        return;
      }

      try {
        await loadFinanceData();
        if (!cancelled) setIsUnlocked(true);
      } catch (error) {
        if (!cancelled) {
          console.error("Session restore failed:", error);
          clearAuthToken();
          setIsUnlocked(false);
          resetFinanceState();
          setSyncStatus("PIN required");
          setIsError(false);
        }
      } finally {
        if (!cancelled) setIsInitializing(false);
      }
    };

    boot();
    return () => {
      cancelled = true;
    };
  }, [loadFinanceData, resetFinanceState]);

  useEffect(() => {
    const handleExpired = () => {
      setIsUnlocked(false);
      resetFinanceState();
      setSyncStatus("Session expired");
      setIsError(true);
    };

    window.addEventListener("auth:expired", handleExpired);
    return () => window.removeEventListener("auth:expired", handleExpired);
  }, [resetFinanceState]);

  const handleUnlocked = useCallback(async () => {
    setIsInitializing(true);

    try {
      await loadFinanceData();
      setIsUnlocked(true);
    } catch (error) {
      console.error("Initial data load failed:", error);
      setSyncStatus("API Error");
      setIsError(true);
    } finally {
      setIsInitializing(false);
    }
  }, [loadFinanceData]);

  // ----------------------------------------------------------
  // Transaction / account / loan / savings actions
  // ----------------------------------------------------------

  const handleDeleteTransaction = async (id: number) => {
    const previousTransactions = transactions;
    const previousAccounts = accounts;

    setTransactions((items) => items.filter((item) => item.id !== id));

    try {
      const response = await api.delete<{ accounts: AccountData[] }>(
        `transactions/delete.php?id=${id}`,
      );
      setAccounts(response.data.accounts);
      setSyncStatus("API Synced");
      setIsError(false);
    } catch (error) {
      console.error(error);
      setTransactions(previousTransactions);
      setAccounts(previousAccounts);
      setSyncStatus("API Error");
      setIsError(true);
    }
  };

  const handleDeleteAccount = async (id: number) => {
    const previous = accounts;
    setAccounts((items) => items.filter((item) => item.id !== id));

    try {
      await api.delete(`accounts/delete.php?id=${id}`);
      await loadFinanceData();
    } catch (error) {
      console.error(error);
      setAccounts(previous);
      setSyncStatus("API Error");
      setIsError(true);
    }
  };

  const handleDeleteLoan = async (id: number) => {
    const previous = loans;
    setLoans((items) => items.filter((item) => item.id !== id));

    try {
      await api.delete(`loans/delete.php?id=${id}`);
      setSyncStatus("API Synced");
      setIsError(false);
    } catch (error) {
      console.error(error);
      setLoans(previous);
      setSyncStatus("API Error");
      setIsError(true);
    }
  };

  const handleDeleteSavings = async (id: number) => {
    const previous = savings;
    setSavings((items) => items.filter((item) => item.id !== id));

    try {
      await api.delete(`savings/delete.php?id=${id}`);
      setSyncStatus("API Synced");
      setIsError(false);
    } catch (error) {
      console.error(error);
      setSavings(previous);
      setSyncStatus("API Error");
      setIsError(true);
    }
  };

  const handleAddTransaction = async (newTx: {
    amount: number;
    type: string;
    desc: string;
    account: string;
    date: string;
    category: string;
  }) => {
    const selectedAccount = accounts.find(
      (account) => account.name === newTx.account,
    );

    if (!selectedAccount) {
      setSyncStatus("Select an account");
      setIsError(true);
      return;
    }

    const selectedCategory = categories.find(
      (category) =>
        category.type === newTx.type &&
        category.name.toLowerCase() === newTx.category.toLowerCase(),
    );

    const optimisticId = Date.now();
    const optimistic: TransactionData = {
      ...newTx,
      id: optimisticId,
      account_id: selectedAccount.id,
      category_id: selectedCategory?.id ?? null,
    };

    setTransactions((items) => [optimistic, ...items]);

    try {
      const response = await api.post<TransactionMutationResponse>(
        "transactions/create.php",
        {
          account_id: selectedAccount.id,
          category_id: selectedCategory?.id ?? null,
          amount: newTx.amount,
          type: newTx.type,
          desc: newTx.desc,
          date: newTx.date,
        },
      );

      setTransactions((items) => [
        response.data.transaction,
        ...items.filter((item) => item.id !== optimisticId),
      ]);
      setAccounts(response.data.accounts);
      setSyncStatus("API Synced");
      setIsError(false);
    } catch (error) {
      console.error(error);
      setTransactions((items) =>
        items.filter((item) => item.id !== optimisticId),
      );
      setSyncStatus("API Error");
      setIsError(true);
    }
  };

  const handleTransferAction = async (data: {
    fromAccountId: number;
    toAccountId: number;
    amount: number;
    desc: string;
  }) => {
    if (data.fromAccountId === data.toAccountId) {
      throw new Error("Choose two different accounts.");
    }

    await api.post("transactions/transfer.php", {
      from_account_id: data.fromAccountId,
      to_account_id: data.toAccountId,
      amount: data.amount,
    });

    await loadFinanceData();
  };

  const handleAddAccount = async (event: React.FormEvent) => {
    event.preventDefault();
    const balance = parseInputValue(newAccBalance);

    if (!newAccName.trim() || !Number.isFinite(balance)) return;

    try {
      const response = await api.post<AccountMutationResponse>(
        "accounts/create.php",
        {
          name: newAccName.trim(),
          balance,
          type: newAccType,
        },
      );

      setAccounts((items) => [...items, response.data.account]);
      setNewAccName("");
      setNewAccBalance("");
      setIsNewAccountModalOpen(false);
      setSyncStatus("API Synced");
      setIsError(false);
    } catch (error) {
      console.error(error);
      setSyncStatus("API Error");
      setIsError(true);
    }
  };

  const resetLoanForm = () => {
    setNewLoanName("");
    setNewLoanType("borrowed");
    setNewLoanTotal("");
    setNewLoanRemaining("");
    setEditingLoanId(null);
  };

  const openLoanCreate = () => {
    resetLoanForm();
    setIsNewLoanModalOpen(true);
  };

  const openLoanEdit = (loan: LoanData) => {
    setEditingLoanId(loan.id);
    setNewLoanName(loan.name);
    setNewLoanType(loan.type);
    setNewLoanTotal(formatInputValue(String(loan.total)));
    setNewLoanRemaining(formatInputValue(String(loan.remaining)));
    setIsNewLoanModalOpen(true);
  };

  const closeLoanModal = () => {
    setIsNewLoanModalOpen(false);
    resetLoanForm();
  };

  const handleAddLoan = async (event: React.FormEvent) => {
    event.preventDefault();

    const total = parseInputValue(newLoanTotal);
    const remaining =
      newLoanRemaining.trim() === ""
        ? total
        : parseInputValue(newLoanRemaining);

    if (
      !newLoanName.trim() ||
      !Number.isFinite(total) ||
      total <= 0 ||
      !Number.isFinite(remaining) ||
      remaining < 0 ||
      remaining > total
    ) {
      setSyncStatus("Check loan values");
      setIsError(true);
      return;
    }

    try {
      const payload = {
        name: newLoanName.trim(),
        total,
        remaining,
        type: newLoanType,
      };

      const response =
        editingLoanId !== null
          ? await api.put<LoanMutationResponse>(
              `loans/update.php?id=${editingLoanId}`,
              payload,
            )
          : await api.post<LoanMutationResponse>("loans/create.php", payload);

      if (editingLoanId !== null) {
        setLoans((items) =>
          items.map((item) =>
            item.id === editingLoanId ? response.data.loan : item,
          ),
        );
      } else {
        setLoans((items) => [...items, response.data.loan]);
      }

      closeLoanModal();
      setSyncStatus("API Synced");
      setIsError(false);
    } catch (error) {
      console.error("Loan save failed:", error);
      setSyncStatus("API Error");
      setIsError(true);
    }
  };

  const resetSavingsForm = () => {
    setEditingSavingsId(null);
    setNewSavingName("");
    setNewSavingTarget("");
    setNewSavingSaved("");
    setNewSavingDate("");
  };

  const openSavingsCreate = () => {
    resetSavingsForm();
    setIsSavingsModalOpen(true);
  };

  const openSavingsEdit = (saving: SavingsData) => {
    setEditingSavingsId(saving.id);
    setNewSavingName(saving.name);
    setNewSavingTarget(formatInputValue(String(saving.target)));
    setNewSavingSaved(formatInputValue(String(saving.saved)));
    setNewSavingDate(saving.target_date ?? "");
    setIsSavingsModalOpen(true);
  };

  const closeSavingsModal = () => {
    setIsSavingsModalOpen(false);
    resetSavingsForm();
  };

  const handleSaveSavings = async (event: React.FormEvent) => {
    event.preventDefault();

    const target = parseInputValue(newSavingTarget);
    const saved =
      newSavingSaved.trim() === "" ? 0 : parseInputValue(newSavingSaved);

    if (
      !newSavingName.trim() ||
      !Number.isFinite(target) ||
      target <= 0 ||
      !Number.isFinite(saved) ||
      saved < 0 ||
      saved > target
    ) {
      setSyncStatus("Check savings values");
      setIsError(true);
      return;
    }

    const payload = {
      name: newSavingName.trim(),
      target,
      saved,
      target_date: newSavingDate || null,
    };

    try {
      const response =
        editingSavingsId !== null
          ? await api.put<SavingsMutationResponse>(
              `savings/update.php?id=${editingSavingsId}`,
              payload,
            )
          : await api.post<SavingsMutationResponse>(
              "savings/create.php",
              payload,
            );

      if (editingSavingsId !== null) {
        setSavings((items) =>
          items.map((item) =>
            item.id === editingSavingsId ? response.data.saving : item,
          ),
        );
      } else {
        setSavings((items) => [...items, response.data.saving]);
      }

      closeSavingsModal();
      setSyncStatus("API Synced");
      setIsError(false);
    } catch (error) {
      console.error("Savings save failed:", error);
      setSyncStatus("API Error");
      setIsError(true);
    }
  };

  const totalBalance = accounts.reduce((sum, item) => sum + item.balance, 0);
  const calculatedIncome = transactions
    .filter((item) => item.type === "income")
    .reduce((sum, item) => sum + item.amount, 0);
  const calculatedExpense = transactions
    .filter((item) => item.type === "expense")
    .reduce((sum, item) => sum + item.amount, 0);

  // ==========================================================
  // Views
  // ==========================================================

  const renderView = () => {
    switch (activeTab) {
      case "home":
        return (
          <div className="space-y-8 mt-2">
            <div className="mx-4 bg-gradient-to-br from-blue-600 to-indigo-700 rounded-[28px] p-6 text-white shadow-xl shadow-blue-600/20 relative overflow-hidden">
              <div className="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full blur-[80px] pointer-events-none -translate-y-1/2 translate-x-1/3" />

              <p className="text-blue-100 text-sm font-medium tracking-wide mb-1">
                Total Net Balance
              </p>
              <h2 className="text-4xl font-extrabold tracking-tight mb-8">
                {formatMMK(totalBalance)}{" "}
                <span className="text-2xl font-semibold opacity-80">MMK</span>
              </h2>

              <div className="grid grid-cols-2 gap-4">
                <div className="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10">
                  <div className="flex items-center gap-1.5 mb-1 text-blue-100 text-xs font-semibold">
                    <TrendingUp size={14} className="text-emerald-300" />
                    Income
                  </div>
                  <p className="text-lg font-bold">
                    + {formatMMK(calculatedIncome)}
                  </p>
                </div>

                <div className="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10">
                  <div className="flex items-center gap-1.5 mb-1 text-blue-100 text-xs font-semibold">
                    <TrendingDown size={14} className="text-red-300" />
                    Expenses
                  </div>
                  <p className="text-lg font-bold">
                    - {formatMMK(calculatedExpense)}
                  </p>
                </div>
              </div>
            </div>

            {isError && (
              <div className="bg-red-50 border border-red-200 rounded-2xl p-4 mx-4 flex gap-3">
                <AlertTriangle className="text-red-500 shrink-0" size={18} />
                <div className="text-xs text-red-800">
                  <p className="font-bold">Sync Error: {syncStatus}</p>
                  <p className="mt-1">
                    Check your API URL, database credentials, or session.
                  </p>
                </div>
              </div>
            )}

            <div>
              <div className="flex justify-between items-end mb-4 px-5">
                <h3 className="text-lg font-bold">My Accounts</h3>
                <button
                  onClick={() => setActiveTab("accounts")}
                  className="text-sm text-blue-600 font-semibold"
                >
                  See All
                </button>
              </div>

              <div className="flex gap-4 overflow-x-auto pb-4 px-4 hide-scrollbar">
                {accounts.map((account) => {
                  let Icon = Landmark;
                  if (account.type === "cash") Icon = Banknote;
                  if (account.type === "ewallet") Icon = Wallet;

                  return (
                    <div
                      key={account.id}
                      className="min-w-[140px] bg-white p-5 rounded-[24px] shadow-sm border border-zinc-100 shrink-0"
                    >
                      <div
                        className={`w-12 h-12 rounded-full flex items-center justify-center mb-4 ${account.bg} ${account.color}`}
                      >
                        <Icon size={22} />
                      </div>
                      <p className="text-xs text-zinc-500 truncate">
                        {account.name}
                      </p>
                      <p className="text-lg font-bold mt-1">
                        {formatMMK(account.balance)}
                      </p>
                    </div>
                  );
                })}

                {accounts.length === 0 && (
                  <div className="px-4 text-sm text-zinc-400">
                    No accounts yet.
                  </div>
                )}
              </div>
            </div>

            <div className="px-4">
              <div className="flex justify-between items-end mb-4 px-1">
                <h3 className="text-lg font-bold">Recent Transactions</h3>
                <button
                  onClick={() => setActiveTab("history")}
                  className="text-sm text-blue-600 font-semibold"
                >
                  See All
                </button>
              </div>

              <div className="bg-white rounded-[28px] shadow-sm border border-zinc-100 overflow-hidden">
                {transactions.slice(0, 4).map((tx, index) => (
                  <SwipeableItem
                    key={tx.id}
                    onDelete={() => handleDeleteTransaction(tx.id)}
                  >
                    <div
                      className={`p-4 flex items-center justify-between bg-white ${
                        index !== 0 ? "border-t border-zinc-100" : ""
                      }`}
                    >
                      <div className="flex items-center gap-4 min-w-0">
                        <div
                          className={`w-12 h-12 rounded-full flex items-center justify-center shrink-0 ${
                            tx.type === "expense"
                              ? "bg-red-50 text-red-500"
                              : "bg-emerald-50 text-emerald-500"
                          }`}
                        >
                          {tx.type === "expense" ? (
                            <TrendingDown size={20} />
                          ) : (
                            <TrendingUp size={20} />
                          )}
                        </div>

                        <div className="min-w-0">
                          <p className="font-bold text-sm truncate">
                            {tx.desc}
                          </p>
                          <p className="text-[11px] text-zinc-500 truncate mt-0.5">
                            {tx.account} • {tx.date}
                          </p>
                        </div>
                      </div>

                      <p
                        className={`font-bold text-sm ${
                          tx.type === "expense"
                            ? "text-red-500"
                            : "text-emerald-500"
                        }`}
                      >
                        {tx.type === "expense" ? "-" : "+"}
                        {formatMMK(tx.amount)}
                      </p>
                    </div>
                  </SwipeableItem>
                ))}

                {transactions.length === 0 && (
                  <div className="p-10 text-center text-sm text-zinc-400">
                    No transactions yet.
                  </div>
                )}
              </div>
            </div>
          </div>
        );

      case "accounts":
        return (
          <div className="space-y-5 px-4 pt-2">
            <div className="flex justify-between items-start">
              <div>
                <h2 className="text-2xl font-bold">Accounts</h2>
                <p className="text-zinc-500 text-sm mt-0.5">
                  Manage your money sources
                </p>
              </div>

              <button
                onClick={() => setIsNewAccountModalOpen(true)}
                className="flex items-center gap-1.5 bg-blue-600 text-white text-xs font-bold px-3 py-2.5 rounded-xl"
              >
                <PlusCircle size={16} />
                Add Account
              </button>
            </div>

            <div className="grid gap-4">
              {accounts.map((account) => {
                let Icon = Landmark;
                if (account.type === "cash") Icon = Banknote;
                if (account.type === "ewallet") Icon = Wallet;

                return (
                  <SwipeableItem
                    key={account.id}
                    onDelete={() => handleDeleteAccount(account.id)}
                    containerClassName="rounded-3xl border border-zinc-100 shadow-sm"
                  >
                    <div className="bg-white p-5 flex items-center justify-between">
                      <div className="flex items-center gap-4">
                        <div
                          className={`w-12 h-12 rounded-full flex items-center justify-center ${account.bg} ${account.color}`}
                        >
                          <Icon size={22} />
                        </div>
                        <div>
                          <p className="font-bold">{account.name}</p>
                          <p className="text-xs text-zinc-500 capitalize">
                            {account.type}
                          </p>
                        </div>
                      </div>
                      <p className="font-bold">
                        {formatMMK(account.balance)} MMK
                      </p>
                    </div>
                  </SwipeableItem>
                );
              })}

              {accounts.length === 0 && (
                <div className="p-10 text-center text-zinc-400 bg-white rounded-3xl">
                  No accounts yet.
                </div>
              )}
            </div>

            {isNewAccountModalOpen && (
              <div className="fixed inset-0 bg-zinc-900/60 backdrop-blur-sm z-[70] flex items-end justify-center">
                <div className="modal-sheet">
                  <div className="flex justify-between items-center mb-6">
                    <h2 className="text-xl font-bold">Add Account</h2>
                    <button
                      onClick={() => setIsNewAccountModalOpen(false)}
                      className="modal-close"
                    >
                      <X size={18} />
                    </button>
                  </div>

                  <form onSubmit={handleAddAccount} className="space-y-5 pb-8">
                    <div>
                      <label className="finance-label">Account Label</label>
                      <input
                        value={newAccName}
                        onChange={(e) => setNewAccName(e.target.value)}
                        className="finance-input"
                        placeholder="e.g. KBZ Bank, Wallet Cash"
                        required
                      />
                    </div>

                    <div>
                      <label className="finance-label">
                        Initial Balance (MMK)
                      </label>
                      <input
                        type="text"
                        inputMode="numeric"
                        value={newAccBalance}
                        onChange={(e) =>
                          setNewAccBalance(formatInputValue(e.target.value))
                        }
                        className="finance-input text-xl font-bold"
                        placeholder="0"
                        required
                      />
                    </div>

                    <div>
                      <label className="finance-label">
                        Account Classification
                      </label>
                      <select
                        value={newAccType}
                        onChange={(e) => setNewAccType(e.target.value)}
                        className="finance-input"
                      >
                        <option value="bank">Traditional Bank</option>
                        <option value="cash">Physical Cash</option>
                        <option value="ewallet">Electronic Wallet</option>
                      </select>
                    </div>

                    <button
                      type="submit"
                      className="w-full py-4 bg-blue-600 text-white font-bold rounded-xl"
                    >
                      Create Account
                    </button>
                  </form>
                </div>
              </div>
            )}
          </div>
        );

      case "history":
        return (
          <div className="space-y-6 px-4 pt-2">
            <div>
              <h2 className="text-2xl font-bold">Ledger History</h2>
              <p className="text-zinc-500 text-sm mt-0.5">
                Swipe left to delete a transaction
              </p>
            </div>

            <div className="bg-white rounded-3xl border border-zinc-100 overflow-hidden divide-y divide-zinc-100">
              {transactions.map((tx) => (
                <SwipeableItem
                  key={tx.id}
                  onDelete={() => handleDeleteTransaction(tx.id)}
                >
                  <div className="p-4 flex items-center justify-between bg-white">
                    <div className="flex items-center gap-4 min-w-0">
                      <div
                        className={`w-12 h-12 rounded-full flex items-center justify-center shrink-0 ${
                          tx.type === "expense"
                            ? "bg-red-50 text-red-500"
                            : "bg-emerald-50 text-emerald-500"
                        }`}
                      >
                        {tx.type === "expense" ? (
                          <TrendingDown size={20} />
                        ) : (
                          <TrendingUp size={20} />
                        )}
                      </div>

                      <div className="min-w-0">
                        <p className="font-bold text-sm truncate">{tx.desc}</p>
                        <p className="text-[11px] text-zinc-500 truncate mt-0.5">
                          {tx.account} • {tx.category} • {tx.date}
                        </p>
                      </div>
                    </div>

                    <p
                      className={`font-bold text-sm ${
                        tx.type === "expense"
                          ? "text-red-500"
                          : "text-emerald-500"
                      }`}
                    >
                      {tx.type === "expense" ? "-" : "+"}
                      {formatMMK(tx.amount)}
                    </p>
                  </div>
                </SwipeableItem>
              ))}

              {transactions.length === 0 && (
                <div className="p-10 text-center text-zinc-400">
                  No transactions yet.
                </div>
              )}
            </div>
          </div>
        );

      case "budgets":
        return (
          <div className="space-y-5 px-4 pt-2">
            <div className="flex justify-between items-start">
              <div>
                <h2 className="text-2xl font-bold">Financial Plans</h2>
                <p className="text-zinc-500 text-sm mt-0.5">
                  Loans, borrowing and savings goals
                </p>
              </div>

              <button
                onClick={
                  financialPlanTab === "loans"
                    ? openLoanCreate
                    : openSavingsCreate
                }
                className="flex items-center gap-1.5 bg-blue-600 text-white text-xs font-bold px-3 py-2.5 rounded-xl"
              >
                <PlusCircle size={16} />
                {financialPlanTab === "loans" ? "Add Loan" : "Add Saving"}
              </button>
            </div>

            <div className="plans-segmented">
              <button
                className={financialPlanTab === "loans" ? "active" : ""}
                onClick={() => setFinancialPlanTab("loans")}
              >
                <CreditCard size={16} />
                Loans & Borrowing
              </button>
              <button
                className={financialPlanTab === "savings" ? "active" : ""}
                onClick={() => setFinancialPlanTab("savings")}
              >
                <PiggyBank size={16} />
                Savings
              </button>
            </div>

            {financialPlanTab === "loans" ? (
              <div className="grid gap-4">
                {loans.map((loan) => {
                  const progress =
                    loan.total > 0
                      ? Math.min(
                          100,
                          Math.max(
                            0,
                            ((loan.total - loan.remaining) / loan.total) * 100,
                          ),
                        )
                      : 0;

                  return (
                    <SwipeableItem
                      key={loan.id}
                      onDelete={() => handleDeleteLoan(loan.id)}
                      containerClassName="rounded-[24px] border border-zinc-100 shadow-sm"
                    >
                      <div className="bg-white p-5">
                        <div className="flex justify-between items-start gap-3">
                          <div className="min-w-0">
                            <p className="font-bold truncate">{loan.name}</p>
                            <p className="text-[10px] text-zinc-400 font-bold tracking-widest uppercase mt-1">
                              {loan.type === "borrowed"
                                ? "Debt to repay"
                                : "Receivable"}
                            </p>
                          </div>

                          <button
                            onClick={() => openLoanEdit(loan)}
                            className="w-9 h-9 shrink-0 rounded-full bg-zinc-100 text-zinc-500 flex items-center justify-center hover:bg-blue-50 hover:text-blue-600"
                            aria-label="Edit loan"
                          >
                            <Pencil size={15} />
                          </button>
                        </div>

                        <div className="flex justify-between items-end mt-5 mb-2">
                          <span className="text-xs text-zinc-400">
                            Remaining
                          </span>
                          <span className="font-bold text-sm">
                            {formatMMK(loan.remaining)} /{" "}
                            {formatMMK(loan.total)} MMK
                          </span>
                        </div>

                        <div className="w-full bg-zinc-100 rounded-full h-2.5 overflow-hidden">
                          <div
                            className={`h-full rounded-full ${
                              loan.type === "borrowed"
                                ? "bg-red-500"
                                : "bg-emerald-500"
                            }`}
                            style={{ width: `${progress}%` }}
                          />
                        </div>
                      </div>
                    </SwipeableItem>
                  );
                })}

                {loans.length === 0 && (
                  <div className="p-10 text-center text-zinc-400 bg-white rounded-3xl border border-zinc-100">
                    No loans or borrowing records yet.
                  </div>
                )}
              </div>
            ) : (
              <div className="grid gap-4">
                {savings.map((saving) => {
                  const progress =
                    saving.target > 0
                      ? Math.min(
                          100,
                          Math.max(0, (saving.saved / saving.target) * 100),
                        )
                      : 0;

                  return (
                    <SwipeableItem
                      key={saving.id}
                      onDelete={() => handleDeleteSavings(saving.id)}
                      containerClassName="rounded-[24px] border border-zinc-100 shadow-sm"
                    >
                      <div className="bg-white p-5">
                        <div className="flex justify-between items-start gap-3">
                          <div className="flex items-center gap-3 min-w-0">
                            <div className="w-11 h-11 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                              <PiggyBank size={21} />
                            </div>

                            <div className="min-w-0">
                              <p className="font-bold truncate">
                                {saving.name}
                              </p>
                              <p className="text-xs text-zinc-400 mt-0.5">
                                {saving.target_date
                                  ? `Target: ${saving.target_date}`
                                  : "Savings goal"}
                              </p>
                            </div>
                          </div>

                          <button
                            onClick={() => openSavingsEdit(saving)}
                            className="w-9 h-9 shrink-0 rounded-full bg-zinc-100 text-zinc-500 flex items-center justify-center hover:bg-emerald-50 hover:text-emerald-600"
                            aria-label="Edit saving"
                          >
                            <Pencil size={15} />
                          </button>
                        </div>

                        <div className="flex justify-between items-end mt-5 mb-2">
                          <p className="text-xl font-extrabold">
                            {formatMMK(saving.saved)}{" "}
                            <span className="text-xs font-medium text-zinc-400">
                              saved
                            </span>
                          </p>
                          <p className="text-sm font-bold text-emerald-600">
                            {Math.round(progress)}%
                          </p>
                        </div>

                        <div className="w-full bg-zinc-100 rounded-full h-2.5 overflow-hidden">
                          <div
                            className="h-full rounded-full bg-gradient-to-r from-emerald-400 to-emerald-600 transition-all"
                            style={{ width: `${progress}%` }}
                          />
                        </div>

                        <p className="text-[11px] text-zinc-400 mt-2">
                          Target {formatMMK(saving.target)} MMK
                        </p>
                      </div>
                    </SwipeableItem>
                  );
                })}

                {savings.length === 0 && (
                  <div className="p-10 text-center text-zinc-400 bg-white rounded-3xl border border-zinc-100">
                    No savings goals yet. Start your first goal.
                  </div>
                )}
              </div>
            )}

            {/* ======================================================
                LOAN MODAL — this is intentionally inside budgets.
                It is the modal opened by Add Loan and Edit Loan.
               ====================================================== */}
            {isNewLoanModalOpen && (
              <div className="fixed inset-0 bg-zinc-900/60 backdrop-blur-sm z-[70] flex items-end justify-center">
                <div className="modal-sheet">
                  <div className="flex justify-between items-center mb-6">
                    <div>
                      <p className="text-xs font-bold uppercase tracking-widest text-blue-600">
                        Loans & Borrowing
                      </p>
                      <h2 className="text-xl font-bold">
                        {editingLoanId !== null
                          ? "Edit Loan"
                          : "New Loan / IOU"}
                      </h2>
                    </div>

                    <button onClick={closeLoanModal} className="modal-close">
                      <X size={18} />
                    </button>
                  </div>

                  <form onSubmit={handleAddLoan} className="space-y-5 pb-8">
                    <div>
                      <label className="finance-label">Who is this with?</label>
                      <input
                        value={newLoanName}
                        onChange={(e) => setNewLoanName(e.target.value)}
                        className="finance-input"
                        placeholder="e.g. John Doe, Bank Loan"
                        required
                      />
                    </div>

                    <div>
                      <label className="finance-label">Type of Loan</label>
                      <select
                        value={newLoanType}
                        onChange={(e) => setNewLoanType(e.target.value)}
                        className="finance-input"
                      >
                        <option value="borrowed">
                          I borrowed money (Debt)
                        </option>
                        <option value="lent">I lent money (Owes me)</option>
                      </select>
                    </div>

                    <div className="grid grid-cols-2 gap-4">
                      <div>
                        <label className="finance-label">Total Amount</label>
                        <input
                          type="text"
                          inputMode="numeric"
                          value={newLoanTotal}
                          onChange={(e) =>
                            setNewLoanTotal(formatInputValue(e.target.value))
                          }
                          className="finance-input text-xl font-bold"
                          placeholder="0"
                          required
                        />
                      </div>

                      <div>
                        <label className="finance-label">Remaining</label>
                        <input
                          type="text"
                          inputMode="numeric"
                          value={newLoanRemaining}
                          onChange={(e) =>
                            setNewLoanRemaining(
                              formatInputValue(e.target.value),
                            )
                          }
                          className="finance-input text-xl font-bold"
                          placeholder="Same as total"
                        />
                      </div>
                    </div>

                    <button
                      type="submit"
                      className="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl"
                    >
                      {editingLoanId !== null ? "Save Changes" : "Create Loan"}
                    </button>
                  </form>
                </div>
              </div>
            )}

            {/* ======================================================
                SAVINGS MODAL
               ====================================================== */}
            {isSavingsModalOpen && (
              <div className="fixed inset-0 bg-zinc-900/60 backdrop-blur-sm z-[70] flex items-end justify-center">
                <div className="modal-sheet">
                  <div className="flex justify-between items-center mb-6">
                    <div>
                      <p className="text-xs font-bold uppercase tracking-widest text-emerald-600">
                        Savings
                      </p>
                      <h2 className="text-xl font-bold">
                        {editingSavingsId !== null
                          ? "Edit Savings Goal"
                          : "New Savings Goal"}
                      </h2>
                    </div>

                    <button onClick={closeSavingsModal} className="modal-close">
                      <X size={18} />
                    </button>
                  </div>

                  <form onSubmit={handleSaveSavings} className="space-y-5 pb-8">
                    <div>
                      <label className="finance-label">Goal Name</label>
                      <input
                        value={newSavingName}
                        onChange={(e) => setNewSavingName(e.target.value)}
                        className="finance-input"
                        placeholder="e.g. New iPhone, Emergency Fund"
                        required
                      />
                    </div>

                    <div>
                      <label className="finance-label">
                        Target Amount (MMK)
                      </label>
                      <input
                        type="text"
                        inputMode="numeric"
                        value={newSavingTarget}
                        onChange={(e) =>
                          setNewSavingTarget(formatInputValue(e.target.value))
                        }
                        className="finance-input text-xl font-bold"
                        placeholder="1,000,000"
                        required
                      />
                    </div>

                    <div>
                      <label className="finance-label">
                        Already Saved (MMK)
                      </label>
                      <input
                        type="text"
                        inputMode="numeric"
                        value={newSavingSaved}
                        onChange={(e) =>
                          setNewSavingSaved(formatInputValue(e.target.value))
                        }
                        className="finance-input text-xl font-bold"
                        placeholder="0"
                      />
                    </div>

                    <div>
                      <label className="finance-label">
                        Target Date (Optional)
                      </label>
                      <input
                        type="date"
                        value={newSavingDate}
                        onChange={(e) => setNewSavingDate(e.target.value)}
                        className="finance-input"
                      />
                    </div>

                    <button
                      type="submit"
                      className="w-full py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl"
                    >
                      {editingSavingsId !== null
                        ? "Save Changes"
                        : "Create Savings Goal"}
                    </button>
                  </form>
                </div>
              </div>
            )}
          </div>
        );

      default:
        return null;
    }
  };

  if (isInitializing) {
    return (
      <div className="bg-zinc-100 h-screen flex justify-center">
        <div className="w-full max-w-md bg-zinc-50 h-full flex items-center justify-center border-x border-zinc-200">
          <div className="text-center">
            <div className="w-10 h-10 rounded-full border-4 border-blue-100 border-t-blue-600 animate-spin mx-auto mb-4" />
            <p className="text-sm font-bold text-zinc-700">{syncStatus}</p>
          </div>
        </div>
      </div>
    );
  }

  if (!isUnlocked) {
    return <PinScreen onUnlocked={handleUnlocked} />;
  }

  const modalOpen =
    isAddModalOpen ||
    isNewAccountModalOpen ||
    isNewLoanModalOpen ||
    isSavingsModalOpen ||
    isTransferModalOpen;

  return (
    <div className="bg-zinc-100 h-screen overflow-hidden flex justify-center">
      <div className="w-full max-w-md bg-zinc-50 h-full relative shadow-[0_0_40px_rgba(0,0,0,0.05)] flex flex-col border-x border-zinc-200 overflow-hidden">
        <TopBar
          title={
            activeTab === "home"
              ? "My Dashboard"
              : activeTab === "budgets"
                ? "Financial Plans"
                : activeTab.charAt(0).toUpperCase() + activeTab.slice(1)
          }
          syncStatus={syncStatus}
          isError={isError}
          onSync={loadFinanceData}
        />

        <main className="flex-1 overflow-y-auto animate-fade-in hide-scrollbar pb-32">
          {renderView()}
        </main>

        {!modalOpen && (
          <BottomNav activeTab={activeTab} setActiveTab={setActiveTab} />
        )}

        {!modalOpen && (
          <button
            onClick={() => setIsAddModalOpen(true)}
            className="finance-fab"
            aria-label="New transaction"
          >
            <Plus size={28} strokeWidth={2.5} />
          </button>
        )}

        <AddTransactionModal
          isOpen={isAddModalOpen}
          onClose={() => setIsAddModalOpen(false)}
          onAdd={handleAddTransaction}
          accounts={accounts}
        />

        <TransferModal
          isOpen={isTransferModalOpen}
          onClose={() => setIsTransferModalOpen(false)}
          onTransfer={handleTransferAction}
          accounts={accounts}
        />
      </div>

      <style
        dangerouslySetInnerHTML={{
          __html: `
            @keyframes slideUp {
              from { transform: translateY(100%); }
              to { transform: translateY(0); }
            }
            @keyframes fadeIn {
              from { opacity: 0; }
              to { opacity: 1; }
            }
            .animate-slide-up {
              animation: slideUp .35s cubic-bezier(.16,1,.3,1) forwards;
            }
            .animate-fade-in {
              animation: fadeIn .25s ease-out forwards;
            }
          `,
        }}
      />
    </div>
  );
}
